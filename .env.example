# Copia este archivo como .env.local y rellena los valores de TU proyecto de Supabase.
# Dónde están: Supabase → botón «Connect» del proyecto, o Project Settings → API Keys.
# Ver README, sección «Variables de entorno».

# PÚBLICA (puede verse en el navegador): URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# PÚBLICA (puede verse en el navegador): Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA (solo servidor; nunca en el navegador ni en GitHub): Secret key (sb_secret_...)
# La usan: pagos (webhook de Stripe), lectura del correo y el borrado definitivo desde Plataforma.
SUPABASE_SECRET_KEY=

# SECRETA (solo servidor): clave gratuita de Google Gemini para el Generador de descripciones.
# Se crea en aistudio.google.com → Get API key. Sin ella, el generador avisa de que falta.
GEMINI_API_KEY=

# Opcional: fijar un modelo de Gemini (por defecto se prueban varios gratuitos en orden si uno está saturado)
# GEMINI_MODEL=

# SECRETAS (solo servidor): credenciales de Google Cloud para «Ventas por correo» (Gmail, solo lectura).
# Se crean en console.cloud.google.com → APIs y servicios → Credenciales. Ver docs/VENTAS-POR-CORREO.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Versión SaaS (varias empresas). Ver docs/SAAS.md
# ---------------------------------------------------------------------
# Dirección pública de la web (enlaces de correos y de Stripe). Ej.: https://maurinventario.vercel.app
NEXT_PUBLIC_SITE_URL=

# SECRETAS (solo servidor): Stripe. Usa claves de prueba (sk_test_...) hasta estar listo para cobrar.
# Sin las tres, la pantalla Suscripción dice «pendiente de configuración» y no se cobra nada.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precio mensual de 4,99 € creado en Stripe (price_...)
STRIPE_PRICE_ID=
# Opcional: 1 para que Stripe calcule el IVA (requiere activar Stripe Tax)
# STRIPE_AUTOMATIC_TAX=1

# Opcional: envío de invitaciones por email con Resend. Sin ellas, se copia el enlace a mano.
# RESEND_API_KEY=
# MAIL_FROM=MaurInventario <no-responder@tudominio.com>

# Datos del titular para Privacidad y Términos
LEGAL_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# Opcional: obligar a conectar una cuenta concreta de Gmail (solo para uso propio, no SaaS)
# GMAIL_REQUIRED_ACCOUNT=
