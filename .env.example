# Copia este archivo como .env.local y rellena los valores de TU proyecto de Supabase.
# Dónde están: Supabase → botón «Connect» del proyecto, o Project Settings → API Keys.
# Ver README, sección «Variables de entorno».

# PÚBLICA (puede verse en el navegador): URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# PÚBLICA (puede verse en el navegador): Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA (solo servidor; nunca en el navegador ni en GitHub): Secret key (sb_secret_...)
# Solo la usa la pantalla Usuarios para crear usuarios y cambiar contraseñas.
SUPABASE_SECRET_KEY=

# SECRETA (solo servidor): clave gratuita de Google Gemini para el Generador de descripciones.
# Se crea en aistudio.google.com → Get API key. Sin ella, el generador avisa de que falta.
GEMINI_API_KEY=

# Opcional: fijar un modelo de Gemini (por defecto se prueban varios gratuitos en orden si uno está saturado)
# GEMINI_MODEL=
